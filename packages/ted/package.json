{
  "name": "@tedengine/ted",
  "version": "0.19.0",
  "scripts": {
    "build": "vite build --config vite.config.mts",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomaisthorpe/tedengine.git",
    "directory": "packages/ted"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "gl-matrix": "^3.4.4",
    "howler": "^2.2.4",
    "react-colorful": "^5.8.1",
    "styled-components": "^6.5.3",
    "uuid": "^14.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@codecov/vite-plugin": "^2.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "jsdom": "^30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
